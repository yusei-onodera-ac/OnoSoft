<Application x:Class="ClipboardHistoryManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- おのソフト共通テーマ(色・スタイル)。OnoSoft.Shared から読み込む。 -->
                <ResourceDictionary Source="pack://application:,,,/OnoSoft.Shared;component/Theme/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
