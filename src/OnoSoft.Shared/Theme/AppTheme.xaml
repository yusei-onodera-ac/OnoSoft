<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- おのソフト共通カラーパレット。各アプリの App.xaml からマージして使う。 -->
    <SolidColorBrush x:Key="BgBrush" Color="#1E1F26"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#2A2B36"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F0F1F5"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="#9A9CAC"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#353748"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3C4A"/>

    <!-- ポップアップ/パネル内の小さいアイコンボタン(ピン留め・削除など)の共通スタイル -->
    <Style x:Key="OnoSoftIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 常駐ポップアップの外枠(角丸パネル)に使う共通スタイル -->
    <Style x:Key="OnoSoftPopupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

</ResourceDictionary>
